# --- Web ---
# AUTH_MODE=development permite probar localmente sin crear todavía OAuth en Google.
# En producción debe ser: google
AUTH_MODE=development
DEV_USER_EMAIL=dev@perfumeriasunidas.com.pe
DEV_USER_NAME=Usuario de desarrollo
SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
ALLOWED_EMAIL_DOMAIN=perfumeriasunidas.com.pe
ALLOWED_HOSTED_DOMAIN=perfumeriasunidas.com.pe
MAX_RANGE_DAYS=93
SEARCH_FALLBACK_DAYS=90

# --- SynerCOM GraphQL / Keycloak ---
GRAPHQL_URL=https://synerpos.com/api/graphql
KC_BASE_URL=https://synerpos.com/auth
KC_REALM=
KC_CLIENT_ID=
KC_CLIENT_SECRET=
KC_USERNAME=
KC_PASSWORD=
# Opcional: ruta a un archivo fuera del repo para cachear el token de Keycloak
# (si no, se renueva en cada arranque).
# KC_CACHE_FILE=
GRAPHQL_COMPANY_ID=

# --- SQL Server PU_SynerPOS (un solo login: lectura + escritura) ---
# MovSynerPos: Pu_synerpos en 172.0.2.162 (usa linked server). TABLE_NAME es
# la tabla espejo de SynerPOS.
#
# DB_USER debe ser synercheck_writer: es el único login de SynerPOS y tiene
# SELECT/INSERT/DELETE sobre MovSynerPos y MovSynerPosQA, y SELECT+INSERT+UPDATE
# sobre SunatValidacion. No hay una cuenta read-only separada ni credenciales
# duplicadas para SUNAT o para el reenvío manual.
DB_HOST=
DB_NAME=
TABLE_NAME=
DB_USER=
DB_USER_PASSWORD=
# Ajustes de conexión de ESTA instancia (172.0.2.162). Intelisis tiene los
# suyos (INTELISIS_TIMEOUT / INTELISIS_ENCRYPT / INTELISIS_TRUST_SERVER_CERTIFICATE)
# y no se comparten.
DB_TIMEOUT=30
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no

# --- Intelisis / Punidas (172.0.1.156) ---
# Venta con Mov SE-* (origen SynerPOS). Si se dejan vacíos, /api/summary
# responde con intelisis_enabled=false (modo degradado, no falla).
#
# Un solo login para lectura y reenvío: la instancia es una sola (PUSVRBD,
# sin AG) y no hay réplica a la que enrutar. Además del SELECT de la pantalla,
# ese login necesita los permisos del reenvío (ver bloque siguiente).
INTELISIS_HOST=
INTELISIS_DB=Punidas
INTELISIS_USER=
INTELISIS_PASSWORD=
# OBLIGATORIA: cada instancia tiene su propio certificado. Este valor NO se
# hereda de DB_TRUST_SERVER_CERTIFICATE. Con certificado autofirmado interno
# usar yes; si el servidor tiene un certificado válido, no. Si INTELISIS_HOST
# está configurado y esta variable falta, la app desactiva Intelisis en vez de
# intentar una conexión TLS que fallaría en silencio.
INTELISIS_TRUST_SERVER_CERTIFICATE=
# Opcionales: puerto/instancia, timeouts y cifrado (mismos defaults que DB_*).
# INTELISIS_PORT=
# INTELISIS_INSTANCE=
# INTELISIS_TIMEOUT=30
# INTELISIS_ENCRYPT=yes

# --- Intelisis / Punidas: REENVÍO MANUAL (cola del ERP) ---
# La pantalla NO crea tablas ni ejecuta el generador: inserta una fila
# EN_COLA en dbo.FE_Reenvio, la misma cola que atiende el worker del ERP
# (C:\Projects\PHP\rmand2\bin\fe_worker.php, tarea programada). El worker
# valida la venta, ejecuta SPPUFE_UBL21 / _NCND y deja el resultado en la
# misma tabla. Ver odd/tasks/intelisis-ufe-runbook.md.
#
# Permisos que debe tener el login de INTELISIS_* para poder reenviar:
#   SELECT en Venta/MovTipo/FE_Worker/FE_Reenvio, INSERT y UPDATE en
#   FE_Reenvio, y EXECUTE de sp_getapplock/sp_releaseapplock. NO necesita
#   EXECUTE de los generadores ni permisos de instancia (xp_cmdshell): eso es
#   del worker PHP del ERP.
#
# Kill switch: apagado, POST /api/intelisis/ufe/reenviar responde 503 y no
# se escribe nada en la cola del ERP. Es lo único que hay que tocar.
INTELISIS_RESEND_ENABLED=false

# Documentos por solicitud de reenvío (1-50). El lote no es atómico: cada
# documento se valida y encola por separado.
# INTELISIS_RESEND_MAX_BATCH=10

# Se envía como APP= en la conexión que escribe en la cola: queda en
# APP_NAME() y permite auditar qué sesión encoló cada solicitud. No es secreto.
# INTELISIS_APP_NAME=syner-check-web

# --- SUNAT Validator (172.0.2.162/sunat-validator) ---
# API Key exclusiva de esta app (la entrega el administrador del servicio).
SUNAT_VALIDATOR_URL=http://172.0.2.162/sunat-validator
SUNAT_VALIDATOR_API_KEY=
# RUC emisor de los comprobantes PU (11 dígitos).
SUNAT_RUC_EMISOR=
# dbo.SunatValidacion usa la conexión de escritura derivada de DB_* (mismo
# host/base/login que el resto de SynerPOS); la tabla es fija y no se configura.
# El login necesita SELECT+INSERT+UPDATE sobre dbo.SunatValidacion.
# Timeout de lectura al registrar un lote (segundos). Un timeout ambiguo
# deja los documentos en SIN_CONFIRMAR para no duplicar el trabajo.
SUNAT_SUBMIT_TIMEOUT_SECONDS=180
# Documentos por lote SUNAT (1-500). Lotes pequeños persisten avance más
# seguido y acotan el impacto de un corte. El máximo duro es 500.
SUNAT_BATCH_SIZE=50
# Worker de reconciliación: cierra jobs aunque el navegador deje de hacer poll.
# Cada cuántos segundos revisa jobs PENDIENTE y cuánto espera antes de marcar
# como ERROR un envío que nunca llegó a guardar su TrabajoID.
SUNAT_WORKER_ENABLED=true
SUNAT_WORKER_INTERVAL_SECONDS=10
SUNAT_STALE_SUBMIT_MINUTES=10

# --- MovSynerPos (reenvío manual SynerCom -> SynerPOS) ---
# INSERT-only. Host, base y login salen de DB_HOST/DB_NAME/DB_USER y la tabla
# destino de TABLE_NAME, igual que en las lecturas. Para probar en QA:
# TABLE_NAME=MovSynerPosQA (DB_NAME no cambia: la tabla QA vive en la misma base).
# Apagado por defecto: sin esta variable en true, /api/movsynerpos/enviar
# responde 503 y no toca la base.
MOVSYNERPOS_WRITE_ENABLED=false

# --- MovSynerPos: borrado de un comprobante erróneo (destructivo) ---
# Capacidad independiente del reenvío: habilitar inserciones no habilita
# borrados. Apagada por defecto. Sin esta variable en true,
# POST /api/movsynerpos/borrar responde 503 y no toca la base.
# Requiere que DB_USER tenga DELETE sobre la tabla de TABLE_NAME:
#   GRANT DELETE ON dbo.MovSynerPos TO synercheck_writer;
# El borrado exige (oid, tipo, number) y un motivo; se bloquea si Intelisis
# ya concluyó la venta (el operador puede usar "forzar" tras anular en el ERP).
MOVSYNERPOS_DELETE_ENABLED=false

# --- SerieSucursal (catálogo de series por sucursal en PU_SynerPOS) ---
# Nombre de la tabla destino en PU_SynerPOS.
# En producción: SerieSucursal
# En QA: configurar aquí el nombre de la tabla de pruebas (ej. SerieSucursalQA)
SERIE_SUCURSAL_TABLE_NAME=SerieSucursal

# Runtime / security
# Local: APP_ENV=development tolera AUTH_MODE=development (OAuth simulada).
# Producción: la app falla al arrancar si se combina APP_ENV=production con
# AUTH_MODE=development, así que en el servidor descomenta el bloque de abajo.
APP_ENV=development
SESSION_HTTPS_ONLY=true
LOG_LEVEL=INFO
GRAPHQL_TIMEOUT=60
# HTTP hardening (optional; values shown are the defaults)
# RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_SUNAT_WRITE_PER_MINUTE=10
# MAX_REQUEST_BYTES=1000000
# ALLOWED_ORIGINS=https://syner-check.example.com
# LOG_FORMAT=json
# WEB_THREAD_POOL_SIZE=8
# --- Producción (descomentar) ---
# APP_ENV=production
# AUTH_MODE=google
