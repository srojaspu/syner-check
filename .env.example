# ==============================================================================
# syner-check-web - Variables de Entorno
# ==============================================================================

# --- Aplicación y Autenticación ---
# Modo de autenticación: development (usuario simulado) o google (OAuth producción)
AUTH_MODE=development
DEV_USER_EMAIL=dev@perfumeriasunidas.com.pe
DEV_USER_NAME=Usuario de desarrollo
SESSION_SECRET=replace-with-a-long-random-secret
SESSION_HTTPS_ONLY=true
APP_ENV=development
LOG_LEVEL=INFO

# Google OAuth (requerido si AUTH_MODE=google)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
ALLOWED_EMAIL_DOMAIN=perfumeriasunidas.com.pe
ALLOWED_HOSTED_DOMAIN=perfumeriasunidas.com.pe

# Límites de búsqueda de comprobantes en días
MAX_RANGE_DAYS=93
SEARCH_FALLBACK_DAYS=90

# --- SynerCOM (GraphQL y Keycloak) ---
GRAPHQL_URL=https://synerpos.com/api/graphql
GRAPHQL_COMPANY_ID=
GRAPHQL_TIMEOUT=60
KC_BASE_URL=https://synerpos.com/auth
KC_REALM=
KC_CLIENT_ID=
KC_CLIENT_SECRET=
KC_USERNAME=
KC_PASSWORD=
# Cache local del token Keycloak (opcional, evita pedir token en cada arranque)
# KC_CACHE_FILE=

# --- SQL Server: PU_SynerPOS (172.0.2.162) ---
# Un solo login (synercheck_writer) para lectura, reenvío manual y caché SUNAT
DB_HOST=
DB_NAME=
TABLE_NAME=
DB_USER=
DB_USER_PASSWORD=
DB_TIMEOUT=30
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no

# Catálogo de series por sucursal en PU_SynerPOS (en QA usar SerieSucursalQA)
SERIE_SUCURSAL_TABLE_NAME=SerieSucursal

# Kill switches para MovSynerPos
MOVSYNERPOS_WRITE_ENABLED=false
MOVSYNERPOS_DELETE_ENABLED=false

# --- SQL Server: Intelisis / Punidas (172.0.1.156) ---
# Instancia independiente de SynerPOS. Vacío activa modo degradado (pantalla deshabilitada)
INTELISIS_HOST=
INTELISIS_DB=Punidas
INTELISIS_USER=
INTELISIS_PASSWORD=
# Obligatoria si se configura host: certificado TLS de esta instancia (yes/no)
INTELISIS_TRUST_SERVER_CERTIFICATE=
# INTELISIS_PORT=
# INTELISIS_INSTANCE=
# INTELISIS_TIMEOUT=30
# INTELISIS_ENCRYPT=yes

# Reenvío manual a cola ERP (dbo.FE_Reenvio)
INTELISIS_RESEND_ENABLED=false
# INTELISIS_RESEND_MAX_BATCH=10
# INTELISIS_APP_NAME=syner-check-web

# --- Validador SUNAT (Microservicio HTTP) ---
SUNAT_VALIDATOR_URL=http://172.0.2.162/sunat-validator
SUNAT_VALIDATOR_API_KEY=
SUNAT_RUC_EMISOR=
SUNAT_SUBMIT_TIMEOUT_SECONDS=180
SUNAT_BATCH_SIZE=50
# Worker en segundo plano para conciliar jobs pendientes
SUNAT_WORKER_ENABLED=true
SUNAT_WORKER_INTERVAL_SECONDS=10
SUNAT_STALE_SUBMIT_MINUTES=10

# --- Endurecimiento HTTP (Opcional, valores por defecto) ---
# RATE_LIMIT_PER_MINUTE=120
# RATE_LIMIT_SUNAT_WRITE_PER_MINUTE=10
# MAX_REQUEST_BYTES=1000000
# ALLOWED_ORIGINS=https://syner-check.example.com
# LOG_FORMAT=json
# WEB_THREAD_POOL_SIZE=8
