# --- Web ---
# AUTH_MODE=development permite probar localmente sin crear todavía OAuth en Google.
# En producción debe ser: google
AUTH_MODE=development
DEV_USER_EMAIL=dev@perfumeriasunidas.com.pe
DEV_USER_NAME=Usuario de desarrollo
SESSION_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxxxxxx
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback
ALLOWED_EMAIL_DOMAIN=perfumeriasunidas.com.pe
ALLOWED_HOSTED_DOMAIN=perfumeriasunidas.com.pe
MAX_RANGE_DAYS=93
SEARCH_FALLBACK_DAYS=90

# --- SynerCOM GraphQL / Keycloak ---
GRAPHQL_URL=https://pu.synercom.pe/api/graphql
KC_BASE_URL=https://sso.synercom.pe/auth
KC_REALM=SynerCOM
KC_CLIENT_ID=pu
KC_CLIENT_SECRET=
KC_USERNAME=
KC_PASSWORD=

# --- SQL Server (read-only account recommended) ---
DB_HOST=
DB_NAME=
TABLE_NAME=dbo.MovSynerPos
DB_USER=
DB_USER_PASSWORD=

# Runtime / security
APP_ENV=production
SESSION_HTTPS_ONLY=true
LOG_LEVEL=INFO
GRAPHQL_TIMEOUT=60

# SQL Server security. For production use a valid certificate when possible.
DB_TIMEOUT=30
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no
DB_APPLICATION_INTENT_READ_ONLY=true
